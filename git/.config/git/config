[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	dark = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[init]
	defaultBranch = main

[fetch]
	prune = true

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[column]
	ui = auto

[color]
	ui = auto
